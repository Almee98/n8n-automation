    {
      "parameters": {
        "jsCode": "function text(value) {\n  return String(value ?? '').trim();\n}\n\nfunction asRows(nodeName) {\n  try {\n    return $(nodeName).all().map((item) => item.json);\n  } catch (error) {\n    return [];\n  }\n}\n\nfunction isRealRow(row) {\n  return text(row['Job ID']) && text(row['Timestamp']);\n}\n\nfunction inLast24Hours(row) {\n  const ts = Date.parse(row['Timestamp']);\n  if (!Number.isFinite(ts)) return false;\n  return Date.now() - ts <= 24 * 60 * 60 * 1000;\n}\n\nfunction line(row) {\n  const company = text(row['Company Identity']) || 'Unknown company';\n  const title = text(row['Job Title']) || 'Untitled';\n  const url = text(row['Apply URL']);\n  const petitioner = text(row['Verified Sponsor Entity Name']);\n  const extra = petitioner ? ` — petitioner: ${petitioner}` : '';\n  const link = url ? ` — ${url}` : '';\n  return `• ${company} — ${title}${extra}${link}`;\n}\n\nfunction section(title, rows) {\n  const body = rows.length ? rows.map(line).join('\\n') : '• (none in the last 24 hours)';\n  return `${title} (${rows.length})\\n${body}`;\n}\n\nconst viable = asRows('Read Viable').filter(isRealRow).filter(inLast24Hours);\nconst lookup = asRows('Read Lookup').filter(isRealRow).filter(inLast24Hours);\nconst sponsor = asRows('Read Sponsor').filter(isRealRow).filter(inLast24Hours);\nconst noH1b = asRows('Read No H-1B').filter(isRealRow).filter(inLast24Hours);\n\nconst textBody = [\n  section('VIABLE JOBS — apply from these', viable),\n  '',\n  section('SPONSOR LOOKUP REVIEW — MyVisaJobs miss; not a discard', lookup),\n  '',\n  section('SPONSOR ENTITY REVIEW — need a petitioner (do not treat as apply-ready)', sponsor),\n  '',\n  section('NO H-1B HISTORY — do not apply', noH1b),\n].join('\\n');\n\nconst subject =\n  `Job search — ${viable.length} viable / ${lookup.length} lookup / ${sponsor.length} review / ${noH1b.length} no-H1B`;\n\nreturn [{ json: { subject, textBody, viableCount: viable.length, lookupCount: lookup.length, sponsorCount: sponsor.length, noH1bCount: noH1b.length } }];"
      },
