    {
      "parameters": {
        "jsCode": "function getSheetRows() {\n  try {\n    return $('Deduplicate By Company Identity').all(0, $runIndex);\n  } catch (error) {\n    return $('Deduplicate By Company Identity').all();\n  }\n}\n\nfunction text(value) {\n  return String(value ?? '').trim();\n}\n\nfunction normalize(value) {\n  return text(value).toLowerCase();\n}\n\nconst sheetRows = getSheetRows().map((item) => item.json);\n\nconst companyRows = $input.all()\n  .map((item) => item.json)\n  .filter((row) => row && row.id && row.identity_name);\n\nconst companyByName = new Map();\n\nfor (const company of companyRows) {\n  companyByName.set(normalize(company.identity_name), company);\n}\n\nreturn sheetRows.map((row) => {\n  const identityName = text(row['Company Identity']);\n  const companyRecord = companyByName.get(normalize(identityName)) ?? null;\n\n  return {\n    json: {\n      ...row,\n      company_record: companyRecord,\n      company_id: companyRecord?.id ?? null,\n      hasCompanyRecord: Boolean(companyRecord),\n    },\n  };\n});"
      },
