      "name": "Route Sponsor Entity Mapping Record"
    },
    {
      "parameters": {
        "jsCode": "function text(value) {\n  return String(value ?? '').trim();\n}\n\nconst byCompanyId = new Map();\n\nfor (const item of $input.all()) {\n  const row = item.json;\n  if (!row.company_id || !row.sponsor_entity_id) continue;\n  if (byCompanyId.has(row.company_id)) continue;\n\n  byCompanyId.set(row.company_id, {\n    company_id: row.company_id,\n    sponsor_entity_id: row.sponsor_entity_id,\n    mapping_status: 'Verified',\n    mapping_source: 'manual_review_sheet',\n    mapping_evidence: text(row['Mapping Evidence / Source']) || text(row['Notes']) || null,\n    verified_at: new Date().toISOString(),\n  });\n}\n\nreturn Array.from(byCompanyId.values()).map((mapping) => ({ json: mapping }));"
      },
