      "parameters": {
        "jsCode": "function text(value) {\n  return String(value ?? '').trim();\n}\n\nconst kept = $input.all()\n  .map((item) => item.json)\n  .filter((row) => {\n    const status = text(row['Review Status']);\n    const name = text(row['Verified Sponsor Entity Name']);\n    return status === 'Verified' && name.length > 0;\n  })\n  .map((row) => ({ json: row }));\n\nreturn kept;"
      },
