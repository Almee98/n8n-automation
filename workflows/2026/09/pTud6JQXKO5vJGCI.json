    {
      "parameters": {
        "jsCode": "function text(value) {\n  return String(value ?? '').trim();\n}\n\nfunction normalize(value) {\n  return text(value).toLowerCase();\n}\n\nconst createdEntities = $input.all()\n  .map((item) => item.json)\n  .filter((row) => row && row.id && row.legal_name);\n\nconst newRows = $('Attach Sponsor Entity Record')\n  .all()\n  .map((item) => item.json)\n  .filter((row) => !row.hasSponsorEntityRecord);\n\nconst entityByName = new Map();\n\nfor (const entity of createdEntities) {\n  entityByName.set(normalize(entity.legal_name), entity);\n}\n\nreturn newRows.map((row) => {\n  const legalName = text(row['Verified Sponsor Entity Name']);\n  const sponsorEntity = entityByName.get(normalize(legalName)) ?? null;\n\n  if (!sponsorEntity) {\n    throw new Error(\n      `Could not attach created sponsor_entities row for \"${legalName}\"`\n    );\n  }\n\n  return {\n    json: {\n      ...row,\n      sponsor_entity: sponsorEntity,\n      sponsor_entity_id: sponsorEntity.id,\n      hasSponsorEntityRecord: true,\n    },\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2240,
        -80
      ],
      "id": "57a6df69-627f-458e-9a66-41b3f2948fd4",
      "name": "Attach Created Sponsor Entity"
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map((item) => item.json);\n\nfor (const row of rows) {\n  if (!row.company_id) {\n    throw new Error(`Missing company_id for \"${row['Company Identity']}\"`);\n  }\n  if (!row.sponsor_entity_id) {\n    throw new Error(`Missing sponsor_entity_id for \"${row['Company Identity']}\"`);\n  }\n}\n\nreturn rows.map((row) => ({\n  json: {\n    ...row,\n    ready_for_mapping: true,\n  },\n}));"
      },
