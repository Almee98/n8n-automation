    {
      "parameters": {
        "jsCode": "function getCanonicalRows() {\n  try {\n    return $('Canonical Sponsor Entity').all(0, $runIndex);\n  } catch (error) {\n    return $('Canonical Sponsor Entity').all();\n  }\n}\n\nconst canonicalRows = getCanonicalRows().map((item) => item.json);\n\nconst mappingRows = $input.all()\n  .map((item) => item.json)\n  .filter((row) => row && row.id && row.company_id);\n\nconst mappingsByCompanyId = new Map();\n\nfor (const mapping of mappingRows) {\n  const existing = mappingsByCompanyId.get(mapping.company_id) ?? [];\n  existing.push(mapping);\n  mappingsByCompanyId.set(mapping.company_id, existing);\n}\n\nreturn canonicalRows.map((row) => {\n  const mappings = mappingsByCompanyId.get(row.company_id) ?? [];\n\n  if (mappings.length > 1) {\n    throw new Error(\n      `Ambiguous verified mappings for company_id=${row.company_id}. Do not pick the first.`\n    );\n  }\n\n  const mapping = mappings.length === 1 ? mappings[0] : null;\n\n  return {\n    json: {\n      ...row,\n      sponsor_entity_mapping: mapping,\n      sponsor_entity_mapping_id: mapping?.id ?? null,\n      hasSponsorEntityMappingRecord: Boolean(mapping),\n    },\n  };\n});"
      },
