    {
      "parameters": {
        "jsCode": "function text(value) {\n  return String(value ?? '').trim();\n}\n\nfunction normalize(value) {\n  return text(value).toLowerCase();\n}\n\nfunction pathFromNotes(row) {\n  const url = text(row['Mapping Evidence / Source']) || text(row['Notes']);\n  try {\n    const parsed = new URL(url);\n    if (!parsed.hostname.includes('myvisajobs.com')) return null;\n    return parsed.pathname.replace(/\\/$/, '') || null;\n  } catch (error) {\n    return null;\n  }\n}\n\nconst entities = new Map();\n\nfor (const item of $input.all()) {\n  const row = item.json;\n  const legalName = text(row['Verified Sponsor Entity Name']);\n  if (!legalName) continue;\n\n  const key = normalize(legalName);\n  if (!entities.has(key)) {\n    entities.set(key, {\n      legal_name: legalName,\n      myvisajobs_name: legalName,\n      myvisajobs_path: pathFromNotes(row),\n    });\n  }\n}\n\nreturn Array.from(entities.values()).map((entity) => ({ json: entity }));"
      },
