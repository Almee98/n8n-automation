      "position": [
        3472,
        -80
      ],
      "id": "3867b913-4672-4f3d-bf55-c993c63e7cc3",
      "name": "Create Sponsor Entity Mapping in Supabase",
      "credentials": {
        "supabaseApi": {
          "id": "Lgy7rtDgGcbRtMBz",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const createdMappings = $input.all()\n  .map((item) => item.json)\n  .filter((row) => row && row.id && row.company_id);\n\nconst newRows = $('Attach Sponsor Entity Mapping Record')\n  .all()\n  .map((item) => item.json)\n  .filter((row) => !row.hasSponsorEntityMappingRecord);\n\nconst mappingByCompanyId = new Map();\n\nfor (const mapping of createdMappings) {\n  mappingByCompanyId.set(mapping.company_id, mapping);\n}\n\nreturn newRows.map((row) => {\n  const mapping = mappingByCompanyId.get(row.company_id) ?? null;\n\n  if (!mapping) {\n    throw new Error(\n      `Could not attach created mapping for company_id=${row.company_id}`\n    );\n  }\n\n  return {\n    json: {\n      ...row,\n      sponsor_entity_mapping: mapping,\n      sponsor_entity_mapping_id: mapping.id,\n      hasSponsorEntityMappingRecord: true,\n    },\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3680,
        -80
      ],
      "id": "ea0d88d8-105a-4f59-80f4-18f28c401d32",
      "name": "Attach Created Mapping"
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map((item) => item.json);\n\nfor (const row of rows) {\n  if (!row.company_id) {\n    throw new Error(`Missing company_id for \"${row['Company Identity']}\"`);\n  }\n  if (!row.sponsor_entity_id) {\n    throw new Error(`Missing sponsor_entity_id for \"${row['Company Identity']}\"`);\n  }\n  if (!row.sponsor_entity_mapping_id) {\n    throw new Error(`Missing mapping id for \"${row['Company Identity']}\"`);\n  }\n}\n\nreturn rows.map((row) => ({\n  json: {\n    ...row,\n    mapping_sync_complete: true,\n  },\n}));"
      },
